      "css": ".ds-dish-ground{background:#F1F6EE;padding:24px;font-family:Manrope,system-ui,sans-serif}.ds-dish{width:260px}.ds-dish-photo{position:relative;aspect-ratio:4/3;border-radius:22px;background:#ECEBE7;box-shadow:0 18px 36px -28px rgba(11,61,31,.6);transition:box-shadow .5s cubic-bezier(.16,1,.3,1)}.ds-dish:hover .ds-dish-photo{box-shadow:0 26px 44px -26px rgba(11,61,31,.65)}.ds-tag{position:absolute;left:8px;top:8px;background:#EDCD49;color:#072813;border-radius:9999px;padding:4px 10px;font:700 12px/1 Manrope,sans-serif}.ds-dish h3{margin:12px 0 0;font:800 22px/1.25 Urbanist,system-ui,sans-serif;color:#0B3D1F}.ds-dish-desc{margin:6px 0 0;font-size:14px;line-height:1.375;color:#45574B}.ds-dish-row{margin-top:12px;display:flex;align-items:center;justify-content:space-between}.ds-dish-row b{font-weight:800;font-size:17px;color:#0B3D1F;font-variant-numeric:tabular-nums}.ds-add{display:inline-flex;align-items:center;gap:6px;height:44px;padding:0 20px;border:0;border-radius:9999px;background:#115A2E;color:#fff;font:700 14px/1 Manrope,sans-serif;cursor:pointer}.ds-add:hover{background:#1A6B39}.ds-add:focus-visible{outline:3px solid #115A2E;outline-offset:3px}"
